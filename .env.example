# Example names only. Inject values through your shell; files are not auto-loaded.
LUNARVEIL_ENV=development
LUNARVEIL_API_HOST=127.0.0.1
LUNARVEIL_API_PORT=3001
# On Render, leave LUNARVEIL_API_PORT unset and the provided PORT is used.
LUNARVEIL_API_BASE_URL=http://127.0.0.1:3001
LUNARVEIL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required database connection strings. Supply your own local credentials.
DATABASE_URL=
LUNARVEIL_DATABASE_URL=

# Runtime secrets: never commit real values.
LUNARVEIL_TRADER_TAG_KEY=
# Optional: omit entirely unless using a shared development matcher key.
# LUNARVEIL_DEV_MATCHER_KEY_SEED=
# Preview hosts: use an HTTPS origin after the web deployment exists.
# LUNARVEIL_ALLOWED_ORIGINS=https://your-web-project.vercel.app
# LUNARVEIL_API_BASE_URL=https://your-api-service.onrender.com

# Explicit chain configuration, needed only for chain workers.
LUNARVEIL_CHAIN_NETWORK=preview
# LUNARVEIL_ADMISSION_CHAIN_MODULE=/absolute/path/to/m3-admission-chain-module.ts
# LUNARVEIL_LEDGER_DECODER_MODULE=/absolute/path/to/your/decoder.ts
# LUNARVEIL_ADMISSION_WALLET_SEED=
# MIDNIGHT_WALLET_SEED=
# PRIVATE_STATE_PASSWORD=
