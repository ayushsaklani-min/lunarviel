# PUBLIC / NETWORK
LUNARVEIL_NETWORK=preprod
MIDNIGHT_RPC_URL=https://rpc.preprod.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
PROOF_SERVER_URL=http://proof-server:6300

# RUNTIME SECRETS — leave unset here; inject through your shell/secret manager.
MIDNIGHT_WALLET_SEED=
PRIVATE_STATE_PASSWORD=

# DATABASE
DATABASE_URL=postgresql://lunarveil:change-me@postgres:5432/lunarveil

# API
API_PORT=4000
API_SESSION_SIGNING_KEY_FILE=/run/secrets/api-session-key
PUBLIC_WEB_ORIGIN=http://localhost:3000

# MATCHER
MATCHER_ENCRYPTION_KEY_REF=local-dev-only-change-me
MATCHER_KEY_ID=dev-key-001
MATCHER_MAX_ORDERS_PER_EPOCH=4
MATCHER_FIRMUP_SECONDS=30

# ORACLE DEMO ADAPTER
REFERENCE_ORACLE_MODE=mock
REFERENCE_ORACLE_SIGNING_KEY_FILE=/run/secrets/oracle-key
REFERENCE_ORACLE_MAX_AGE_SECONDS=15

# SECURITY
LOG_LEVEL=info
LOG_REQUEST_BODIES=false
SENTRY_DSN=

# NEVER PUT REAL WALLET SEEDS OR PRIVATE KEYS HERE IN SHARED/COMMITTED FILES.
